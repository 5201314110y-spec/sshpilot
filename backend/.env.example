# Copy to .env and fill in.

# JWT signing secret — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Fernet key for encrypting SSH credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is derived from SECRET_KEY (DEV ONLY — do not use in prod).
ENCRYPTION_KEY=

# Anthropic API key for the agent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
AGENT_MODEL=claude-sonnet-4-20250514
DATABASE_URL=sqlite+aiosqlite:///./sshpilot.db
DEBUG=false
